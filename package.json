{
  "name": "@particle-academy/last-word-ui",
  "version": "0.4.0",
  "description": "A read-only, paged React viewer for a last-word Doc: each page at its paper size, automatic breaks by content height, header and footer bands with live page numbers, footnotes at the page foot, and Word-faithful tables. Scales to fit, never reflows.",
  "keywords": [
    "docx",
    "word",
    "document",
    "viewer",
    "pagination",
    "last-word",
    "react",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/last-word-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/last-word-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/last-word-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite demo",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@particle-academy/react-fancy": ">=5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@particle-academy/last-word": "^0.11.0",
    "@particle-academy/react-fancy": "^5.71.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
